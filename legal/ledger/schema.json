{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/legal/ledger/schema.json",
  "title": "Public corpus provenance and release-evidence ledger v1",
  "description": "Structure only; admission.py additionally enforces hashes, exact licensing, notices and manual review.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "dataset_version", "artifact_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "decision_url"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "decision_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "kind": {"enum": ["dictionary", "morphology", "examples", "font", "pronunciation", "vector_art", "visual_asset"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "kind", "origin_url", "publisher", "author", "dataset_version", "retrieval", "license", "status", "alterations"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/kind"},
        "origin_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publisher": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1, "description": "Named author, or synthetic-fixture for tests. Presence is not a redistribution approval."},
        "dataset_version": {"type": "string", "minLength": 1},
        "retrieval": {
          "type": "object", "additionalProperties": false,
          "required": ["identity", "url", "date", "artifact_path", "sha256"],
          "properties": {
            "identity": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "date": {"type": "string", "format": "date"},
            "artifact_path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "license": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "evidence_url", "evidence_path", "evidence_sha256"],
          "properties": {
            "id": {"enum": ["CC-BY-SA-4.0", "GFDL-1.3-only", "CC0-1.0", "PUBLIC-DOMAIN", "CC-BY-2.0-FR"]},
            "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "evidence_path": {"type": "string", "minLength": 1},
            "evidence_sha256": {"$ref": "#/$defs/sha256"},
            "co_offered_licenses": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"enum": ["CC-BY-SA-4.0", "GFDL-1.3-only", "CC0-1.0", "PUBLIC-DOMAIN"]},
              "description": "Additional licenses the publisher explicitly offers alongside license.id. NC and ND identifiers are never co-offerable and always conflict."
            },
            "artwork_evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "artwork_evidence_path": {"type": "string", "minLength": 1},
            "artwork_evidence_sha256": {"$ref": "#/$defs/sha256"},
            "public_domain_proof": {
              "type": "object", "additionalProperties": false,
              "required": ["jurisdiction", "legal_basis", "work_date"],
              "properties": {
                "jurisdiction": {"type": "string", "minLength": 1},
                "legal_basis": {"type": "string", "minLength": 1},
                "work_date": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "status": {"enum": ["BLOCKED_LICENSE", "REVIEW_REQUIRED", "APPROVED_FOR_REDISTRIBUTION"]},
        "alterations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "kind", "artifact_path", "sha256", "source_refs", "output_license_id", "compiler_license_id", "notices", "compliance", "provenance_mode", "review"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/kind"},
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "output_license_id": {"enum": ["CC-BY-SA-4.0", "GFDL-1.3-only", "CC0-1.0", "PUBLIC-DOMAIN", "CC-BY-2.0-FR"]},
        "compiler_license_id": {"type": "string", "minLength": 1},
        "notices": {"type": "object", "additionalProperties": {"type": "string"}},
        "compliance": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "provenance_mode": {"enum": ["per_record", "source_set"]},
        "record_sources": {
          "type": "array", "items": {
            "type": "object", "required": ["record_id", "source_ids"],
            "properties": {"record_id": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
          }
        },
        "record_provenance_reason": {"type": "string"},
        "gfdl_license_copy_path": {"type": "string"},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  },
  "oneOf": [
    {
      "title": "Source registry",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sources"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    {
      "title": "Daily admission manifest",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "date", "release_candidates"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "date": {"type": "string", "format": "date"},
        "release_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      }
    }
  ]
}
