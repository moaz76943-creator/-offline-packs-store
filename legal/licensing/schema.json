{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/legal/licensing/schema.json",
  "title": "Open Lexical Source Licensing Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/licensing_record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "license_id": {
      "enum": [
        "CC-BY-SA-4.0",
        "CC-BY-SA-3.0",
        "GFDL-1.3-only",
        "CC0-1.0",
        "PUBLIC-DOMAIN",
        "CC-BY-4.0",
        "MIT",
        "OdbL-1.0"
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "evidence"],
      "properties": {
        "declared": {
          "type": "string",
          "description": "The license identifier or text declared by the source."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {
              "$ref": "#/$defs/license_id"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "licensing_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "author",
        "version",
        "license",
        "modification_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_hash": {
          "$ref": "#/$defs/sha256",
          "description": "Actual source hash when artifact exists"
        },
        "modification_status": {
          "enum": ["unmodified", "modified"]
        },
        "license": {
          "$ref": "#/$defs/license"
        }
      }
    }
  }
}
