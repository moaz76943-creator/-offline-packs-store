{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Licensing Ledger Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "author", "declared_license"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "declared_license": {
      "type": "string",
      "minLength": 1
    },
    "verified_evidence": {
      "type": "boolean"
    },
    "modification_status": {
      "type": "string",
      "enum": ["modified", "unmodified"]
    },
    "source_hash": {
      "type": "string"
    },
    "co_offered_licenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
