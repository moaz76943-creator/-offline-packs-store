{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/legal/licensing/schema.json",
  "title": "Lexical Source Licensing Ledger",
  "description": "Schema for source-specific licensing records to block distribution when required evidence is missing.",
  "type": "object",
  "required": ["source_id", "url", "author", "version", "license", "modification_status"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modification_status": {
      "type": "string",
      "enum": ["unmodified", "modified"]
    },
    "license": {
      "type": "object",
      "required": ["declared", "evidence", "obligations_met"],
      "properties": {
        "declared": {
          "type": "string",
          "enum": ["CC-BY-SA-4.0", "GFDL-1.3-only", "CC0-1.0", "PUBLIC-DOMAIN"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "obligations_met": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
