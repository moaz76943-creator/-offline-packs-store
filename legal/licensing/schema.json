{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/legal/licensing/schema.json",
  "title": "Lexical Source Licensing Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "url", "author", "version",
          "license", "modification_status"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "author": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["declared_license", "evidence"],
            "properties": {
              "declared_license": {
                "enum": [
                  "CC-BY-SA-4.0",
                  "GFDL-1.3-only",
                  "CC0-1.0",
                  "PUBLIC-DOMAIN"
                ]
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["verified", "obligations_met"],
                "properties": {
                  "verified": {"type": "boolean"},
                  "obligations_met": {
                    "type": "object",
                    "additionalProperties": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "modification_status": {
            "type": "string",
            "enum": ["unmodified", "modified"]
          }
        }
      }
    }
  }
}
