{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/legal/licensing/schema.json",
  "title": "Open Lexical Source Licensing Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "url", "author", "version", "modification_status", "license"],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "modification_status": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence"],
      "properties": {
        "declared": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["licenses"],
          "properties": {
            "licenses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "obligations_met": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}