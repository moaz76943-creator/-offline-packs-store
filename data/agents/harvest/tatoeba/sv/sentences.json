      "record_id": "tatoeba:337413",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Vi trodde att det var ett flygande tefat."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341910",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Detta är huset jag bodde i när jag var barn."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341938",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Vi hade roligt på stranden igår."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341939",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Jag spelade tennis hela dagen."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341940",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "De skymtade mannen genom folkmassan."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341941",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Han vande sig kvickt vid det kalla vädret."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341942",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Jag blev till slut klar med arbetet."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341943",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Jag kan inte komma på någon bra ursäkt till varför jag är sen till tandläkaren."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:341944",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Kan du simma lika snabbt som honom?"
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353815",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Han är inte läkare."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353816",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hon skulle gärna kommit men hon var på semester."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353817",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Åh nej! Mitt hus brinner!"
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353818",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Jag trodde aldrig att ett såhär fint hotell skulle finnas på en sådan här plats."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353819",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Detta är deras hus."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353820",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Men hon tyckte om barn och gillade sitt jobb."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353821",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hon tycker mycket om att skriva dikter."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353822",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Jag kan inte stå ut med detta ljudet längre."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353823",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hon bad mig att se efter hennes bebis medans hon var borta."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353824",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Han gnäller alltid på dålig medicinsk behandling."
    },
    {
      "author": "Tobberoth",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:353825",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Stick härifrån, ungjävlar!"
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372403",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hon är en tillförlitlig person."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372416",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Solen skiner."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372419",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Den här boken verkar intressant."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372420",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Det var en ny bok."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372423",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Vems bok är det?"
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372425",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Den här boken tillhör skolbiblioteket."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372426",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Den här boken handlar om Kina."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372427",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Lägg inte plånboken på elementet."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372428",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Du är så trevlig."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372429",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Åh, herregud!"
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372430",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Du bör inte lämna barnet ensamt."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372441",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Studenterna lyssnar på en föreläsning i historia."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372445",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Idag mår jag mycket bättre."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372449",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Skolan ser ut som ett fängelse."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372451",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Alla dessa böcker är mina."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372453",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Behöver du den här boken?"
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372466",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hon ville resa."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372468",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Framför oss stod en skrattande flicka."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372471",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Han arbetar åtta timmar om dagen."
    },
    {
      "author": "ilayde",
      "language": "sv",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:372473",
      "retrieval_date": "2026-11-04",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Jag pratar inte tyska."
    }
  ],
