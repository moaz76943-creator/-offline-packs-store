      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Goedemorgen, hoe maakt u het?"
    },
    {
      "author": "Dorenda",
      "language": "nl",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5962",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Muiriel is nu 20 jaar oud."
    },
    {
      "author": "Dorenda",
      "language": "nl",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5963",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ik weet het niet."
    },
    {
      "author": "Dorenda",
      "language": "nl",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
