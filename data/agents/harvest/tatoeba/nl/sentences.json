      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hoe is het weer?"
    },
    {
      "author": "Dorenda",
      "language": "nl",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
