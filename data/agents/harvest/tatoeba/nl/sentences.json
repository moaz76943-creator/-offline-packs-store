      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Gerechtigheid is duur."
    },
    {
      "author": "Dorenda",
      "language": "nl",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5965",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "De meeste mensen denken dat ik gek ben."
    },
    {
      "author": "Dorenda",
      "language": "nl",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
