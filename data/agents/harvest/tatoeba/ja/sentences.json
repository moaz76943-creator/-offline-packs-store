      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "長い目で見れば違ってくると思います。"
    },
    {
      "author": "Swift",
      "language": "ja",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:4734",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "心配しないで。"
    },
    {
      "author": "bunbuku",
      "language": "ja",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:4735",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "会えなくて淋しい。"
    },
    {
      "author": "bunbuku",
      "language": "ja",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:4736",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "明日帰ったら電話します。"
    },
    {
      "author": "lunefumet",
      "language": "ja",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:4737",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "私はいつも不思議な性格の方が好きだった。"
    },
    {
      "author": "bunbuku",
      "language": "ja",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
