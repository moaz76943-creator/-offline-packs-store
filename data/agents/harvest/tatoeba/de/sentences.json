      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Lass uns etwas versuchen!"
    },
    {
      "author": "cburgmer",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:78",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich muss schlafen gehen."
    },
    {
      "author": "TRANG",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:80",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Was ist das?"
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:81",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Heute ist der 18. Juni und das ist der Geburtstag von Muiriel!"
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:82",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Herzlichen Glückwunsch zum Geburtstag, Muiriel!"
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:83",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Muiriel ist jetzt 20."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:84",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das Passwort ist \"Muiriel\"."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:85",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich werde bald zurück sein."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:87",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich finde keine Worte."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:88",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das wird nie enden."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:89",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich weiß einfach nicht, was ich sagen soll."
    },
    {
      "author": "cburgmer",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:90",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das war ein böses Kaninchen."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:91",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich war in den Bergen."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:93",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich weiß nicht, ob ich Zeit dazu habe."
    },
    {
      "author": "MUIRIEL",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:94",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Aus irgendeinem Grund hat das Mikrofon gerade nicht funktioniert."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:95",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Letztendlich muss jeder selbst lernen."
    },
    {
      "author": "cburgmer",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:96",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Die Ausbildung in dieser Welt enttäuscht mich."
    },
    {
      "author": "MUIRIEL",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:97",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Zum Lernen sollte man nicht gezwungen werden. Zum Lernen sollte man ermutigt werden."
    },
    {
      "author": "MUIRIEL",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:98",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Es ist eine schwere Aufgabe, zwischen \"richtig\" und \"falsch\" zu unterscheiden, aber man muss es tun."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:99",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das wird nichts ändern."
    },
    {
      "author": "Safari",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:100",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das wird 30 € kosten."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:101",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich verdiene 100 Euro pro Tag."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:102",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Es kann sein, dass ich bald aufgebe und stattdessen ein Nickerchen mache."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:103",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das liegt daran, dass du nicht allein sein willst."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:104",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Das wird nicht passieren."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:105",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Manchmal kann er ein seltsamer Junge sein."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:106",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich werde mir Mühe geben, dich nicht beim Lernen zu stören."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:107",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich kann mich nur fragen, ob es für alle anderen dasselbe ist."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:108",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich vermute, das ist anders, wenn du darüber längerfristig nachdenkst."
    },
    {
      "author": "Dorenda",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:109",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Mach dir keine Sorgen."
    },
    {
      "author": "MUIRIEL",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:110",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich vermisse dich."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:111",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich werde sie morgen anrufen, wenn ich zurückkomme."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:112",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich mochte mysteriöse Charaktere schon immer mehr."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:113",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Du solltest schlafen."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:115",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich sagte ihnen, sie sollen mir ein neues Ticket schicken."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:116",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Du bist so ungeduldig mit mir."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:117",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich kann so ein Leben nicht leben."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:118",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich wollte mal Astrophysiker werden."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:119",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ich mochte Biologie noch nie."
    },
    {
      "author": "ludoviko",
      "language": "de",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:120",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Die letzte Person, der ich meine Idee erzählt habe, dachte, ich wäre bekloppt."
    }
  ],
