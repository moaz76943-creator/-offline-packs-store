      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Lorsqu'il a demandé qui avait cassé la fenêtre, tous les garçons ont pris un air innocent."
    },
    {
      "author": "hortusdei",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:1279",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne supporte pas ce type."
    },
    {
      "author": "TRANG",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:1441",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Pour une fois dans ma vie je fais un bon geste... Et ça ne sert à rien."
    },
    {
      "author": "hortusdei",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:1593",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ne tenez aucun compte de ce qu'il dit."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3091",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Essayons quelque chose !"
    },
    {
      "author": "brauliobezerra",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3093",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Qu'est-ce que tu fais ?"
    },
    {
      "author": "TRANG",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3094",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Qu'est-ce que c'est ?"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3095",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Aujourd'hui nous sommes le 18 juin et c'est l'anniversaire de Muiriel !"
    },
    {
      "author": "sysko",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3096",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Joyeux anniversaire Muiriel !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3097",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Muiriel a 20 ans maintenant."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3098",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Le mot de passe est « Muiriel »."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3099",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je serai bientôt de retour."
    },
    {
      "author": "Sprachprofi",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3100",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne sais pas."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3101",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "J'en perds mes mots."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3102",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça ne va jamais finir."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3103",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne sais simplement pas quoi dire..."
    },
    {
      "author": "zmoo",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3104",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C’était un méchant lapin."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3105",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "J'étais dans les montagnes."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3106",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Est-ce que c'est une photo récente ?"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3107",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne sais pas si j'ai le temps."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3108",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Pour une certaine raison le microphone ne marchait pas tout à l'heure."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3109",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Tout le monde doit apprendre par soi-même en fin de compte."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3110",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "L'éducation dans ce monde me déçoit."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3111",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "L'apprentissage ne devrait pas être forcé. L'apprentissage devrait être encouragé."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3112",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est une tâche difficile, choisir ce qui est « bon » ou « mauvais », mais il faut le faire."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3113",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça ne changera rien."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3114",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça coûtera 30 €."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3115",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je gagne 100 € par jour."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3116",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Il se peut que j'abandonne bientôt et fasse une sieste à la place."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3117",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est parce que tu ne veux pas être seul."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3118",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça n'arrivera pas."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3119",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Parfois il peut être un gars bizarre."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3120",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ferai de mon mieux pour ne pas perturber tes révisions."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3121",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne peux que me demander si c'est la même chose pour tous les autres."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3122",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je suppose que c'est différent quand tu y penses à long terme."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3123",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ne t'inquiète pas."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3124",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Tu me manques."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3125",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je les appellerai demain quand je reviendrai."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3126",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "J'ai toujours plus apprécié les personnages mystérieux."
    },
    {
      "author": "Pharamp",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3127",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Tu devrais dormir."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3129",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je leur ai dit de m'envoyer un autre ticket."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3130",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Tu es tellement impatiente avec moi."
    },
    {
      "author": "zmoo",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3131",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne peux pas vivre comme ça."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3132",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Il fut un temps où je voulais être astrophysicien."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3133",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je n'ai jamais aimé la biologie."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3134",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "La dernière personne à qui j'ai raconté mon idée a pensé que j'étais cinglé."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3135",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Si le monde n'était pas dans l'état où il est maintenant, je pourrais faire confiance à n'importe qui."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3136",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est malheureusement vrai."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3137",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ils sont trop occupés à se battre entre eux pour s'occuper d'idéaux communs."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3138",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "La plupart des gens pensent que je suis fou."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3139",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Non je ne le suis pas, c'est toi qui l'es !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3140",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est ma réplique !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3141",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Il me donne des coups de pied !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3142",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Est-ce que tu es sûr ?"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3143",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Alors il y a un problème..."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3144",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Oh, il y a un papillon !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3145",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Dépêche-toi !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3146",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça ne me surprend pas."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3147",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Si je pouvais être comme ça..."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3148",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Pour une raison que j'ignore, je me sens plus vivant la nuit."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3149",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça dépend du contexte."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3150",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Est-ce que tu te fous de moi ? !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3151",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est la chose la plus stupide que j'ai jamais dite."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3152",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne veux pas être lamentable, je veux être cool ! !"
    },
    {
      "author": "chika",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3153",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Quand je serai grand, je veux être roi."
    },
    {
      "author": "ipridian",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3154",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "L'Amérique est un endroit charmant pour vivre, si c'est pour gagner de l'argent."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3155",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je suis si gros."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3156",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Et alors ?"
    },
    {
      "author": "chika",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3157",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je vais le descendre."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3158",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne suis pas un vrai poisson, je ne suis qu'une simple peluche."
    },
    {
      "author": "zmoo",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3159",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je ne fais que parler !"
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3160",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'était probablement ce qui a influencé leur décision."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3161",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Je me suis toujours demandé ce que ça ferait d'avoir des frères et sœurs."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3162",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est ce que j'aurais dit."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3163",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ça me prendrait l'éternité pour tout expliquer."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3164",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est parce que tu es une fille."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3165",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Parfois je ne peux pas m'empêcher de montrer des émotions."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3166",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "C'est un mot pour lequel j'aimerais trouver un substitut."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3167",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ce serait quelque chose qu'il faudrait que je programme."
    },
    {
      "author": "ANH_DAO",
      "language": "fr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:3168",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Il n'est pas dans mon intention d'être égoïste."
    }
  ],
