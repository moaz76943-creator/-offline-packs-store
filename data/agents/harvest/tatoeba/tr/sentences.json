      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Devenin belini kıran son saman çöpüdür."
    },
    {
      "author": "sysko",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:338316",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bütün insanlar hür, haysiyet ve haklar bakımından eşit doğarlar. Akıl ve vicdana sahiptirler ve birbirlerine karşı kardeşlik zihniyeti ile hareket etmelidirler."
    },
    {
      "author": "fatih",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:349063",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bilmiyorum."
    },
    {
      "author": "fatih",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:349066",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Mum kendiliğinden söndü."
    },
    {
      "author": "fatih",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:349067",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Mum kendi kendine söndü."
    },
    {
      "author": "fatih",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:349068",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Babam bana yatakta kitap okumamamı söyledi."
    },
    {
      "author": "human600",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:351764",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "On, on bir, on iki, on üç, on dört, on beş, on altı, on yedi, on sekiz, on dokuz, yirmi."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355656",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ek olarak yaşlılar birbirleriyle sosyalleşebilsin ve Amerikan hayatının aktif üyeleri olarak kalabilsinler diye birçok topluluk kurulmuştur."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355657",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bazıları yalnızca zaman geçsin diye kitap okurlar."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355658",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Koyu kahverengi saçları vardı."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355659",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bu gemi okyanus yolculuğu için uygun değil."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355660",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bu kitap."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355661",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Hemen yolculuğa hazırlan."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355662",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Masanın üstündeki hesap makinesi benim."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355663",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Şimşek çaktı."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355664",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Aşk onu rüyalarında görmektir."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355666",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Kimse benim fikirlerimi dinlemek istemiyor."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355672",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Sana satranç oynamayı öğreteceğim."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355676",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Satranç oynamayı biliyor musun?"
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355682",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bunlar çok eski kitaplar."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355683",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bunlar benim kitaplarım."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355684",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bunlar bizim kitaplarımız."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355685",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bunlar benim kalemlerim."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355686",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bunlar her yerde satılıyor."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355690",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bu kitap okul kütüphanesinin."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355692",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Köpekleri severim."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355694",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bulaşık makinesinin nasıl çalıştığını anlatabilir misin?"
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355698",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Zor durumlarla başa çıkamıyor."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355700",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Günde en az yedi saat uyumak zorundayız."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355707",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Sporu rekabet için değil zevk için yapıyorum."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355711",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Japonca konuşamıyorum."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355786",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Yalnızca birkaç kişi vaktinde geldi."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355883",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Sadece birkaç kişi beni anladı."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355890",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Koşucuyum."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355912",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Geçen sene kurulan lunapark sağolsun şehir popüler oldu."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355916",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Onunla beraber olduğun sürece mutlu olamazsın."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355918",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Çocuklar yerde uyumak zorunda kalacaklar gibi."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:355919",
      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Şarkıları gençler arasında iyi biliniyor."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
