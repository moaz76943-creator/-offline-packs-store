      "retrieval_date": "2026-11-01",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Bir davetiye aldım."
    },
    {
      "author": "Denizar",
      "language": "tr",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
