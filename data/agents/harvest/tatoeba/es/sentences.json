      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Intentemos algo!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2482",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Tengo que irme a dormir."
    },
    {
      "author": "hayastan",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2483",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¿Qué estás haciendo?"
    },
    {
      "author": "TRANG",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2484",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¿Qué es eso?"
    },
    {
      "author": "cueyayotl",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2485",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Hoy es 18 de junio y es el cumpleaños de Muiriel!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2486",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Feliz cumpleaños, Muiriel!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2487",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Ahora, Muiriel tiene 20 años."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2488",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "La contraseña es \"Muiriel\"."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2489",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Volveré pronto."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2491",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No tengo palabras."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2492",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Esto no acabará nunca."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2493",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Simplemente no sé qué decir..."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2494",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Era un conejo malo."
    },
    {
      "author": "mamat",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2495",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Yo estaba en las montañas."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2496",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¿Es una foto reciente?"
    },
    {
      "author": "cueyayotl",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2497",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No sé si tengo tiempo."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2498",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Por alguna razón, el micrófono no había funcionado hasta entonces."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2499",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Todo el mundo debe aprender por sí mismo al final."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2500",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "La educación en este mundo me decepciona."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2501",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "El aprendizaje no debe ser forzado, sino estimulado."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2502",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Es una tarea difícil elegir qué está \"bien\" o \"mal\", pero has de hacerlo."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2503",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso no va a cambiar nada."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2504",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso va a costar 30 €."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2505",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Gano 100 € al día."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2506",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Quizás me dé pronto por vencido y en lugar de eso me eche una siesta."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2507",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso es porque no quieres estar solo."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2508",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso no va a pasar."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2509",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "A veces él puede ser un chico raro."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2510",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Me voy a esforzar por no molestarte en tus estudios."
    },
    {
      "author": "japegon",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2511",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Sólo puedo preguntarme si acaso es lo mismo para todos los demás."
    },
    {
      "author": "DanaDescalza",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2512",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Supongo que es diferente cuando lo consideras a largo plazo."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2513",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No te preocupes."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2515",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Los llamaré cuando regrese mañana."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2516",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Siempre me gustaron más los personajes misteriosos."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2517",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Deberías dormir."
    },
    {
      "author": "Raimondi",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2519",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Les dije que me mandaran otro boleto."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2520",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eres tan impaciente conmigo."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2521",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No puedo vivir así."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2522",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Una vez quise ser astrofísico."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2523",
      "retrieval_date": "2026-11-02",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Nunca me gustó la biología."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2524",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "La última persona a la que le conté mi idea pensó que yo estaba loco."
    },
    {
      "author": "Zifre",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2525",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Si el mundo no fuera como es, yo podría confiar en cualquiera."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2526",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Desafortunadamente es verdad."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2527",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Están muy ocupados peleándose entre ellos, como para preocuparse por los ideales comunes."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2528",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "La mayoría de la gente cree que estoy loco."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2529",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡No, no lo soy! ¡Lo eres tú!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2530",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Esa es mi frase!"
    },
    {
      "author": "Zifre",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2531",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡¡Él está pateándome!!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2532",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¿Estás seguro?"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2533",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Entonces tenemos un problema..."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2534",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Ah, allí hay una mariposa!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2535",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Date prisa!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2536",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No me sorprende."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2537",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Si yo pudiera ser así..."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2538",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Por alguna razón, me siento más vivo por la noche."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2539",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso depende del contexto."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2540",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡¿Acaso te quieres burlar de mí?!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2541",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Es la cosa más estúpida que he dicho nunca."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2542",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡¡No quiero ser patético, quiero ser guay!!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2543",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Cuando crezca, quiero ser un rey."
    },
    {
      "author": "Zifre",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2544",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "América es un lugar encantador para vivir, si estás aquí para ganar dinero."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2545",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Estoy tan gordo."
    },
    {
      "author": "Raimondi",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2546",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¿Entonces qué?"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2547",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Voy a pegarle un tiro."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2548",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No soy un pez de verdad, sólo soy un peluche."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2549",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¡Yo sólo lo digo!"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2550",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso fue probablemente lo que influenció su decisión."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2551",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Siempre me he preguntado cómo será tener hermanos."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2552",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Esto es lo que yo habría dicho."
    },
    {
      "author": "ventana",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2553",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Me tomaría una eternidad explicarte todo."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2554",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso es porque eres una chica."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2555",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Algunas veces no puedo evitar mostrar mis sentimientos."
    },
    {
      "author": "jorgearestrepo",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2556",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Es una palabra para la que me gustaría encontrar una sustituta."
    },
    {
      "author": "Zifre",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2557",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Eso sería algo que habría que programar."
    },
    {
      "author": "Zifre",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2558",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "No tengo la intención de ser egoísta."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2559",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Pensemos en lo peor que podría pasar."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2560",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "¿Cuántos amigos íntimos tienes?"
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2561",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Yo puedo ser antisocial, pero eso no significa que no hable con la gente."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2562",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Así ha sido siempre."
    },
    {
      "author": "Shishir",
      "language": "es",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:2563",
      "retrieval_date": "2026-11-06",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Creo que lo mejor es no ser maleducado."
    }
  ],
