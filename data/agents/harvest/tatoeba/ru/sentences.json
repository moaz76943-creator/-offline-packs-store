      "record_id": "tatoeba:243",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Один раз в жизни я делаю хорошее дело... И оно бесполезно."
    },
    {
      "author": "zmoo",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5409",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Давайте что-нибудь попробуем!"
    },
    {
      "author": "Tonari",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5410",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Мне пора идти спать."
    },
    {
      "author": "Aleksej",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5411",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Что ты делаешь?"
    },
    {
      "author": "TRANG",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5412",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Что это?"
    },
    {
      "author": "Olya",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5413",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Сегодня 18 июня, и это день рождения Мюриэл!"
    },
    {
      "author": "Olya",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5414",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "С днём рождения, Мюриэл!"
    },
    {
      "author": "Olya",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5415",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Мюриэл сейчас 20."
    },
    {
      "author": "Olya",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5416",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Пароль «Muiriel»."
    },
    {
      "author": "ae5s",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5419",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "У меня нет слов."
    },
    {
      "author": "ae5s",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5421",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Не знаю, что и сказать."
    },
    {
      "author": "papersaltserver",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5422",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Это был злой кролик."
    },
    {
      "author": "Tonari",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5424",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.question",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Это новая фотография?"
    },
    {
      "author": "al_ex_an_der",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5425",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я не знаю, будет ли у меня время."
    },
    {
      "author": "Ann74",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5426",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Микрофон по какой-то причине до этого не работал."
    },
    {
      "author": "Farol",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5427",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Каждый, в итоге, должен учиться сам."
    },
    {
      "author": "al_ex_an_der",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5429",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Учиться нельзя заставлять. Учёбу нужно поощрять."
    },
    {
      "author": "al_ex_an_der",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5430",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Нелегко решать, что правильно, а что нет, но приходится это делать."
    },
    {
      "author": "zmoo",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5431",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Это ничего не изменит."
    },
    {
      "author": "Ann74",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5433",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я зарабатываю сто евро в день."
    },
    {
      "author": "shanghainese",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5434",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я, может, скоро сдамся и вместо этого пойду вздремну."
    },
    {
      "author": "ae5s",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5436",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Этого не случится."
    },
    {
      "author": "sobr_vamp",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5437",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Иногда он очень странен."
    },
    {
      "author": "al_ex_an_der",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5438",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я постараюсь не мешать тебе учиться."
    },
    {
      "author": "al_ex_an_der",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5439",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я могу только догадываться, так ли это и для всех остальных."
    },
    {
      "author": "Dorenda",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5440",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я полагаю, это будет выглядеть несколько иначе, когда ты подумаешь об этом в долгосрочном плане."
    },
    {
      "author": "Tonari",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5441",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Не беспокойся."
    },
    {
      "author": "zmoo",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5442",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я скучаю по тебе."
    },
    {
      "author": "Farol",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5443",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я позвоню им завтра, когда вернусь домой."
    },
    {
      "author": "Tonari",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5444",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Мне всегда больше нравились таинственные персонажи."
    },
    {
      "author": "shanghainese",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5445",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Тебе лучше поспать."
    },
    {
      "author": "Tonari",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5446",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я пойду."
    },
    {
      "author": "al_ex_an_der",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5447",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я сказал им послать мне ещё один билет."
    },
    {
      "author": "Ann74",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5448",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "У тебя не хватает терпения на меня."
    },
    {
      "author": "corvard",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5449",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я так жить не могу."
    },
    {
      "author": "zmoo",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5450",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Когда-то я хотел быть астрофизиком."
    },
    {
      "author": "Tonari",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5451",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Я никогда не любил биологию."
    },
    {
      "author": "Ann74",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5452",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Последний человек, которому я рассказал свою идею, решил, что я сумасшедший."
    },
    {
      "author": "poji",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5453",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "Если бы мир не был таким, каков он сейчас, я мог бы доверять людям."
    },
    {
      "author": "ae5s",
      "language": "ru",
      "license_id": "CC-BY-2.0-FR",
      "origin_url": "https://tatoeba.org/en/terms_of_use",
      "record_id": "tatoeba:5454",
      "retrieval_date": "2026-11-03",
      "section": "sentences",
      "sentence_slot": "sentence.statement",
      "source_id": "tatoeba.sentences",
      "status": "keep",
      "text": "К сожалению, это правда."
    }
  ],
