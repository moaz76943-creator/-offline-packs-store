      "retrieval_date": "2026-11-02",
      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "The Fallujah fighting has killed fair numbers of Iraqi noncombatants, including Shaikh Abdul Wahhab al-Janabi of the respected Association of Muslim Scholars."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
      "record_id": "ud:en_ewt:weblog-juancole.com_juancole_20041111060900_ENG_20041111_060900-0003",
