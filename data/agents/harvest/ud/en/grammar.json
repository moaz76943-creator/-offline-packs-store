      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "Simplicity gave it that blessed, laudatory lack of clutter, the efficient and effective text-based ads, and the support of anyone with a dial-up connection."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
      "record_id": "ud:en_ewt:weblog-blogspot.com_marketview_20040611132900_ENG_20040611_132900-0008",
