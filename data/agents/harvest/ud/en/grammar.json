      "retrieval_date": "2026-11-02",
      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "US Marines moved into most of Fallujah on Wednesday, though they were still meeting pockets of resistance."
