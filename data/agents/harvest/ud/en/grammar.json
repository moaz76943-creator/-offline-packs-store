      "retrieval_date": "2026-11-02",
      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "He reports that the Iraqi Islamic Party, which had earlier been absolutely committed to getting out the Sunni vote, is now wavering and saying their position will depend on the situation."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
      "record_id": "ud:en_ewt:weblog-juancole.com_juancole_20041111060900_ENG_20041111_060900-0013",
      "retrieval_date": "2026-11-02",
      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "The outbreak of demonstrations and violence throughout the Sunni Arab regions on Wednesday did not bode well for Sunni participation in the January elections."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
