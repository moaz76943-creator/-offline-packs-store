      "retrieval_date": "2026-11-02",
      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "As the survey cited in the above-linked article shows, most Google users don't intend to use Gmail, and Google isn't even as popular as Yahoo! and AOL."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
