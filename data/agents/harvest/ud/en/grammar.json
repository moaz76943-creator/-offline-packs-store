      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "That's overstating it, I know."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
      "record_id": "ud:en_ewt:weblog-blogspot.com_marketview_20040611132900_ENG_20040611_132900-0006",
      "retrieval_date": "2026-11-02",
      "section": "grammar",
      "sentence_slot": "sentence.statement",
      "source_id": "universal-dependencies",
      "status": "keep",
      "text": "What they wonder is whether Google can be anything more than what it's always been -- a great search engine with some real grass-roots support, successful by the grace of simplicity."
    },
    {
      "language": "en",
      "license_id": "CC-BY-SA-4.0",
      "origin_url": "https://github.com/UniversalDependencies/UD_English-EWT",
      "record_id": "ud:en_ewt:weblog-blogspot.com_marketview_20040611132900_ENG_20040611_132900-0007",
