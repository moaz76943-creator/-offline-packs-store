      "record_id": "tatoeba:3110",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "L'éducation dans ce monde me déçoit."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3111",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "L'apprentissage ne devrait pas être forcé. L'apprentissage devrait être encouragé."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3112",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "C'est une tâche difficile, choisir ce qui est « bon » ou « mauvais », mais il faut le faire."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3113",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Ça ne changera rien."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3114",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Ça coûtera 30 €."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3115",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Je gagne 100 € par jour."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3116",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Il se peut que j'abandonne bientôt et fasse une sieste à la place."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3117",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "C'est parce que tu ne veux pas être seul."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3118",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Ça n'arrivera pas."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3119",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Parfois il peut être un gars bizarre."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3120",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Je ferai de mon mieux pour ne pas perturber tes révisions."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3121",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Je ne peux que me demander si c'est la même chose pour tous les autres."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3122",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Je suppose que c'est différent quand tu y penses à long terme."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3123",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Ne t'inquiète pas."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3124",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Tu me manques."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3125",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Je les appellerai demain quand je reviendrai."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3126",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "J'ai toujours plus apprécié les personnages mystérieux."
    },
    {
      "id": "sentence.statement",
      "language": "fr",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:3127",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Tu devrais dormir."
    }
  ]
}
