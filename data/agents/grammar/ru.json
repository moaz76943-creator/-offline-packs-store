      "language": "ru",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:5430",
      "retrieval_date": "2026-11-03",
      "source_id": "tatoeba.sentences",
      "value": "Нелегко решать, что правильно, а что нет, но приходится это делать."
