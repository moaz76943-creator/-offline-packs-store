      "record_id": "tatoeba:143",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich werde ihn erschießen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:144",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich bin kein echter Fisch, ich bin nur ein einfaches Plüschtier."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "B2",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:145",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich sag's ja nur!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:146",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wahrscheinlich war es das, was ihre Entscheidung beeinflusst hat."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:147",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich habe mich immer gefragt, wie es wäre, Geschwister zu haben."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:148",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das hätte ich gesagt."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:149",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es würde ewig dauern, alles zu erklären."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:150",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es liegt daran, dass du ein Mädchen bist."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:151",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Manchmal kann ich es nicht vermeiden, Gefühle zu zeigen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:152",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es ist ein Wort, für das ich gerne einen Ersatz finden würde."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:153",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das wäre etwas, das ich programmieren sollte."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:154",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich beabsichtige nicht, selbstsüchtig zu sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:155",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Lass uns über das Schlimmste, das passieren könnte, nachdenken."
    },
    {
      "id": "sentence.question",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:156",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wie viele enge Freunde hast du?"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:157",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich bin vielleicht asozial, aber das heißt nicht, dass ich nicht mit Leuten rede."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:158",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das ist immer so gewesen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:159",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich denke, es ist am besten, nicht unhöflich zu sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:160",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Man kann immer Zeit finden."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:77",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Lass uns etwas versuchen!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:78",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich muss schlafen gehen."
    },
    {
      "id": "sentence.question",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:80",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Was ist das?"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:81",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Heute ist der 18. Juni und das ist der Geburtstag von Muiriel!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:82",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Herzlichen Glückwunsch zum Geburtstag, Muiriel!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:83",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Muiriel ist jetzt 20."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:84",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das Passwort ist \"Muiriel\"."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:85",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich werde bald zurück sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:87",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich finde keine Worte."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:88",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das wird nie enden."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:89",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich weiß einfach nicht, was ich sagen soll."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:90",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das war ein böses Kaninchen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:91",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich war in den Bergen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:93",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich weiß nicht, ob ich Zeit dazu habe."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:94",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Aus irgendeinem Grund hat das Mikrofon gerade nicht funktioniert."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:95",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Letztendlich muss jeder selbst lernen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:96",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Die Ausbildung in dieser Welt enttäuscht mich."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:97",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Zum Lernen sollte man nicht gezwungen werden. Zum Lernen sollte man ermutigt werden."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:98",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Es ist eine schwere Aufgabe, zwischen \"richtig\" und \"falsch\" zu unterscheiden, aber man muss es tun."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:99",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das wird nichts ändern."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:100",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das wird 30 € kosten."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:101",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich verdiene 100 Euro pro Tag."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:102",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Es kann sein, dass ich bald aufgebe und stattdessen ein Nickerchen mache."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:103",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das liegt daran, dass du nicht allein sein willst."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:104",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Das wird nicht passieren."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:105",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Manchmal kann er ein seltsamer Junge sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:106",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich werde mir Mühe geben, dich nicht beim Lernen zu stören."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:107",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich kann mich nur fragen, ob es für alle anderen dasselbe ist."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:108",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich vermute, das ist anders, wenn du darüber längerfristig nachdenkst."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:109",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Mach dir keine Sorgen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:110",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich vermisse dich."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:111",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich werde sie morgen anrufen, wenn ich zurückkomme."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:112",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich mochte mysteriöse Charaktere schon immer mehr."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:113",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Du solltest schlafen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:115",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich sagte ihnen, sie sollen mir ein neues Ticket schicken."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:116",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Du bist so ungeduldig mit mir."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:117",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich kann so ein Leben nicht leben."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:118",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich wollte mal Astrophysiker werden."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:119",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ich mochte Biologie noch nie."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:120",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Die letzte Person, der ich meine Idee erzählt habe, dachte, ich wäre bekloppt."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:121",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wenn die Welt nicht so wäre wie sie jetzt ist, könnte ich jedem vertrauen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:122",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Unglücklicherweise stimmt es."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:123",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Sie sind zu sehr damit beschäftigt, sich gegenseitig zu bekämpfen, als dass sie sich gemeinsamen Idealen widmen könnten."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:124",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Die meisten Leute denken, ich sei verrückt."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:125",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Nein, ich bin es nicht, du bist es!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:126",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das war mein Satz!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:127",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Er tritt mich!"
    },
    {
      "id": "sentence.question",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:128",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Bist du sicher?"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:129",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Dann haben wir ein Problem..."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:130",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Oh, da ist ein Schmetterling!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:131",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Beeil dich!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:132",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es überrascht mich nicht."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:133",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wenn ich so sein könnte..."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:134",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Aus irgendeinem Grund fühle ich mich nachts lebendiger."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:135",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das kommt auf den Zusammenhang an."
    },
    {
      "id": "sentence.question",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:136",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Willst du mich verdammt nochmal auf den Arm nehmen?!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:137",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das ist das Dümmste, was ich je gesagt habe."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:138",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich will nicht erbärmlich sein, ich will cool sein!!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:139",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wenn ich groß bin, will ich ein König sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:140",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es ist wundervoll in Amerika zu sein, wenn man hier ist, um Geld zu verdienen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:141",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich bin so dick."
    },
    {
      "id": "sentence.question",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:142",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Na und?"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:143",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich werde ihn erschießen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:144",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich bin kein echter Fisch, ich bin nur ein einfaches Plüschtier."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:145",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich sag's ja nur!"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:146",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wahrscheinlich war es das, was ihre Entscheidung beeinflusst hat."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:147",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich habe mich immer gefragt, wie es wäre, Geschwister zu haben."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:148",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das hätte ich gesagt."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:149",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es würde ewig dauern, alles zu erklären."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:150",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es liegt daran, dass du ein Mädchen bist."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:151",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Manchmal kann ich es nicht vermeiden, Gefühle zu zeigen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:152",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Es ist ein Wort, für das ich gerne einen Ersatz finden würde."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:153",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das wäre etwas, das ich programmieren sollte."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:154",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich beabsichtige nicht, selbstsüchtig zu sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:155",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Lass uns über das Schlimmste, das passieren könnte, nachdenken."
    },
    {
      "id": "sentence.question",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:156",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Wie viele enge Freunde hast du?"
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:157",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich bin vielleicht asozial, aber das heißt nicht, dass ich nicht mit Leuten rede."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:158",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Das ist immer so gewesen."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:159",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Ich denke, es ist am besten, nicht unhöflich zu sein."
    },
    {
      "id": "sentence.statement",
      "language": "de",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:160",
      "retrieval_date": "2026-11-05",
      "source_id": "tatoeba.sentences",
      "value": "Man kann immer Zeit finden."
    }
  ]
}
