      "record_id": "tatoeba:372627",
      "retrieval_date": "2026-11-07",
      "source_id": "tatoeba.sentences",
      "value": "Jag brukar diska."
    },
    {
      "id": "sentence.statement",
      "language": "sv",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:372628",
      "retrieval_date": "2026-11-07",
      "source_id": "tatoeba.sentences",
      "value": "Det är varmt idag."
