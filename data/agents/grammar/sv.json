    {
      "id": "sentence.statement",
      "language": "sv",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:401232",
      "retrieval_date": "2026-11-07",
      "source_id": "tatoeba.sentences",
      "value": "I medicinsk forskning är ett av de största problemen att ta reda på orsaken till sjukdomen."
