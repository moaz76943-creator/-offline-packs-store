      "source_id": "tatoeba.sentences",
      "value": "Gano 100 € al día."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2506",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Quizás me dé pronto por vencido y en lugar de eso me eche una siesta."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2507",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eso es porque no quieres estar solo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2508",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eso no va a pasar."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2509",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "A veces él puede ser un chico raro."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2510",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Me voy a esforzar por no molestarte en tus estudios."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2511",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Sólo puedo preguntarme si acaso es lo mismo para todos los demás."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2512",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Supongo que es diferente cuando lo consideras a largo plazo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2513",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "No te preocupes."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2515",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Los llamaré cuando regrese mañana."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2516",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Siempre me gustaron más los personajes misteriosos."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2517",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Deberías dormir."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2519",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Les dije que me mandaran otro boleto."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2520",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eres tan impaciente conmigo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2521",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "No puedo vivir así."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2522",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Una vez quise ser astrofísico."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2523",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Nunca me gustó la biología."
