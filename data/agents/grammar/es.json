      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2547",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Voy a pegarle un tiro."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2548",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "No soy un pez de verdad, sólo soy un peluche."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "B2",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2549",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡Yo sólo lo digo!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2550",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso fue probablemente lo que influenció su decisión."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2551",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Siempre me he preguntado cómo será tener hermanos."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2552",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Esto es lo que yo habría dicho."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2553",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Me tomaría una eternidad explicarte todo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2554",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso es porque eres una chica."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2555",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Algunas veces no puedo evitar mostrar mis sentimientos."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2556",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Es una palabra para la que me gustaría encontrar una sustituta."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2557",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso sería algo que habría que programar."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2558",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "No tengo la intención de ser egoísta."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2559",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Pensemos en lo peor que podría pasar."
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2560",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¿Cuántos amigos íntimos tienes?"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2561",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Yo puedo ser antisocial, pero eso no significa que no hable con la gente."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2562",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Así ha sido siempre."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": "C1",
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2563",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Creo que lo mejor es no ser maleducado."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2481",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "¡Intentemos algo!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2482",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Tengo que irme a dormir."
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2483",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "¿Qué estás haciendo?"
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2484",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "¿Qué es eso?"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2485",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "¡Hoy es 18 de junio y es el cumpleaños de Muiriel!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2486",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "¡Feliz cumpleaños, Muiriel!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2487",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Ahora, Muiriel tiene 20 años."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2488",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "La contraseña es \"Muiriel\"."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2489",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Volveré pronto."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2491",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "No tengo palabras."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2492",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Esto no acabará nunca."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2493",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Simplemente no sé qué decir..."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2494",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Era un conejo malo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2495",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Yo estaba en las montañas."
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2496",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "¿Es una foto reciente?"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2497",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "No sé si tengo tiempo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2498",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Por alguna razón, el micrófono no había funcionado hasta entonces."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2499",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Todo el mundo debe aprender por sí mismo al final."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2500",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "La educación en este mundo me decepciona."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2501",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "El aprendizaje no debe ser forzado, sino estimulado."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2502",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Es una tarea difícil elegir qué está \"bien\" o \"mal\", pero has de hacerlo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2503",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eso no va a cambiar nada."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2504",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eso va a costar 30 €."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2505",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Gano 100 € al día."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2506",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Quizás me dé pronto por vencido y en lugar de eso me eche una siesta."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2507",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eso es porque no quieres estar solo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2508",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eso no va a pasar."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2509",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "A veces él puede ser un chico raro."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2510",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Me voy a esforzar por no molestarte en tus estudios."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2511",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Sólo puedo preguntarme si acaso es lo mismo para todos los demás."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2512",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Supongo que es diferente cuando lo consideras a largo plazo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2513",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "No te preocupes."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2515",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Los llamaré cuando regrese mañana."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2516",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Siempre me gustaron más los personajes misteriosos."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2517",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Deberías dormir."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2519",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Les dije que me mandaran otro boleto."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2520",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Eres tan impaciente conmigo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2521",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "No puedo vivir así."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2522",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Una vez quise ser astrofísico."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2523",
      "retrieval_date": "2026-11-02",
      "source_id": "tatoeba.sentences",
      "value": "Nunca me gustó la biología."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2524",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "La última persona a la que le conté mi idea pensó que yo estaba loco."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2525",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Si el mundo no fuera como es, yo podría confiar en cualquiera."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2526",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Desafortunadamente es verdad."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2527",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Están muy ocupados peleándose entre ellos, como para preocuparse por los ideales comunes."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2528",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "La mayoría de la gente cree que estoy loco."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2529",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡No, no lo soy! ¡Lo eres tú!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2530",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡Esa es mi frase!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2531",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡¡Él está pateándome!!"
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2532",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¿Estás seguro?"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2533",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Entonces tenemos un problema..."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2534",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡Ah, allí hay una mariposa!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2535",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡Date prisa!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2536",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "No me sorprende."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2537",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Si yo pudiera ser así..."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2538",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Por alguna razón, me siento más vivo por la noche."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2539",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso depende del contexto."
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2540",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡¿Acaso te quieres burlar de mí?!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2541",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Es la cosa más estúpida que he dicho nunca."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2542",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡¡No quiero ser patético, quiero ser guay!!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2543",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Cuando crezca, quiero ser un rey."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2544",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "América es un lugar encantador para vivir, si estás aquí para ganar dinero."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2545",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Estoy tan gordo."
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2546",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¿Entonces qué?"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2547",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Voy a pegarle un tiro."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2548",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "No soy un pez de verdad, sólo soy un peluche."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2549",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¡Yo sólo lo digo!"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2550",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso fue probablemente lo que influenció su decisión."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2551",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Siempre me he preguntado cómo será tener hermanos."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2552",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Esto es lo que yo habría dicho."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2553",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Me tomaría una eternidad explicarte todo."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2554",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso es porque eres una chica."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2555",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Algunas veces no puedo evitar mostrar mis sentimientos."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2556",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Es una palabra para la que me gustaría encontrar una sustituta."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2557",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Eso sería algo que habría que programar."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2558",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "No tengo la intención de ser egoísta."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2559",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Pensemos en lo peor que podría pasar."
    },
    {
      "id": "sentence.question",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2560",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "¿Cuántos amigos íntimos tienes?"
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2561",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Yo puedo ser antisocial, pero eso no significa que no hable con la gente."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2562",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Así ha sido siempre."
    },
    {
      "id": "sentence.statement",
      "language": "es",
      "level": null,
      "license_id": "CC-BY-2.0-FR",
      "record_id": "tatoeba:2563",
      "retrieval_date": "2026-11-06",
      "source_id": "tatoeba.sentences",
      "value": "Creo que lo mejor es no ser maleducado."
    }
  ]
}
