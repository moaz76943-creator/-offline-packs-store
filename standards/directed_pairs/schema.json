{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/directed_pairs/schema.json",
  "title": "Open Directed-Pair Translation Data Standard 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_id", "pairs"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "document_id": {"$ref": "#/$defs/id"},
    "pairs": {"type": "array", "items": {"$ref": "#/$defs/pair"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$"},
    "text": {"type": "string", "minLength": 1},
    "optText": {"type": ["string", "null"], "minLength": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "origin_url", "publisher", "dataset_version", "retrieval_id", "license_id", "publication_approved", "fixture_only"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "origin_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "publisher": {"$ref": "#/$defs/text"},
        "dataset_version": {"$ref": "#/$defs/text"},
        "retrieval_id": {"$ref": "#/$defs/text"},
        "license_id": {"$ref": "#/$defs/text"},
        "record_locator": {"$ref": "#/$defs/text"},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "publication_approved": {"type": "boolean"},
        "fixture_only": {"type": "boolean"}
      }
    },
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["pair_id", "source_language", "target_language", "source_sense_id", "target_sense_id", "target_text", "equivalence", "source"],
      "properties": {
        "pair_id": {"$ref": "#/$defs/id"},
        "source_language": {"$ref": "#/$defs/lang"},
        "target_language": {"$ref": "#/$defs/lang"},
        "source_sense_id": {"$ref": "#/$defs/id"},
        "target_sense_id": {"$ref": "#/$defs/id"},
        "target_text": {"$ref": "#/$defs/text"},
        "equivalence": {"enum": ["exact", "approximate", "contextual"]},
        "context": {"$ref": "#/$defs/optText"},
        "domain": {"$ref": "#/$defs/optText"},
        "examples": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
