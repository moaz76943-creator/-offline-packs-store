{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/directed_pairs/directed_pair.schema.json",
  "title": "Directed-Pair Translation Data Standard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "senses",
    "directed_translations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "$ref": "#/$defs/id"
    },
    "senses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sense"
      }
    },
    "directed_translations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directed_translation"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "source_version"
      ],
      "properties": {
        "provenance_id": {
          "$ref": "#/$defs/id"
        },
        "source_version": {
          "$ref": "#/$defs/text"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sense_id",
        "language"
      ],
      "properties": {
        "sense_id": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "$ref": "#/$defs/lang"
        }
      }
    },
    "directed_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation_id",
        "source_sense_id",
        "target_sense_id",
        "source_language",
        "target_language",
        "text",
        "equivalence",
        "source"
      ],
      "properties": {
        "translation_id": {
          "$ref": "#/$defs/id"
        },
        "source_sense_id": {
          "$ref": "#/$defs/id"
        },
        "target_sense_id": {
          "$ref": "#/$defs/id"
        },
        "source_language": {
          "$ref": "#/$defs/lang"
        },
        "target_language": {
          "$ref": "#/$defs/lang"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "equivalence": {
          "enum": [
            "exact",
            "approximate",
            "contextual"
          ]
        },
        "context": {
          "$ref": "#/$defs/text"
        },
        "domain": {
          "$ref": "#/$defs/text"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
