{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/directed_pairs/directed_pair.schema.json",
  "title": "Public directional translation provenance standard 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "senses",
    "pairs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "senses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sense"
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pair"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sense_id",
        "language",
        "definition"
      ],
      "properties": {
        "sense_id": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "$ref": "#/$defs/lang"
        },
        "definition": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "source_version",
        "confidence"
      ],
      "properties": {
        "provenance_id": {
          "$ref": "#/$defs/id"
        },
        "source_version": {
          "$ref": "#/$defs/text"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "from_sense_id",
        "to_sense_id",
        "translation_text",
        "equivalence",
        "source"
      ],
      "properties": {
        "pair_id": {
          "$ref": "#/$defs/id"
        },
        "from_sense_id": {
          "$ref": "#/$defs/id"
        },
        "to_sense_id": {
          "$ref": "#/$defs/id"
        },
        "translation_text": {
          "$ref": "#/$defs/text"
        },
        "equivalence": {
          "enum": [
            "literal",
            "contextual",
            "approximate",
            "related"
          ]
        },
        "context": {
          "$ref": "#/$defs/text"
        },
        "domain": {
          "$ref": "#/$defs/text"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
