{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/directed_pairs/directed_pairs.schema.json",
  "title": "Directional multilingual lexical translation contract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "document_id",
    "source_language",
    "target_language",
    "pairs"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "$ref": "#/$defs/id"
    },
    "source_language": {
      "$ref": "#/$defs/lang"
    },
    "target_language": {
      "$ref": "#/$defs/lang"
    },
    "pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/directedPair"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "optText": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "origin_url",
        "publisher",
        "dataset_version",
        "retrieval_id",
        "license_id",
        "record_locator",
        "publication_approved",
        "fixture_only"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "origin_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "publisher": {
          "$ref": "#/$defs/text"
        },
        "dataset_version": {
          "$ref": "#/$defs/text"
        },
        "retrieval_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z$"
        },
        "license_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9\\.\\-]+$"
        },
        "record_locator": {
          "type": "string",
          "minLength": 1
        },
        "publication_approved": {
          "type": "boolean"
        },
        "fixture_only": {
          "type": "boolean"
        }
      }
    },
    "exampleTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "text",
        "source"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/lang"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example_id",
        "sense_id",
        "text",
        "translations",
        "source"
      ],
      "properties": {
        "example_id": {
          "$ref": "#/$defs/id"
        },
        "sense_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "translations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exampleTranslation"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "directedPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "source_sense_id",
        "target_sense_id",
        "source_lexeme_id",
        "target_lexeme_id",
        "target_text",
        "equivalence",
        "confidence",
        "source"
      ],
      "properties": {
        "pair_id": {
          "$ref": "#/$defs/id"
        },
        "source_sense_id": {
          "$ref": "#/$defs/id"
        },
        "target_sense_id": {
          "$ref": "#/$defs/id"
        },
        "source_lexeme_id": {
          "$ref": "#/$defs/id"
        },
        "target_lexeme_id": {
          "$ref": "#/$defs/id"
        },
        "target_text": {
          "$ref": "#/$defs/text"
        },
        "context": {
          "$ref": "#/$defs/optText"
        },
        "domain": {
          "$ref": "#/$defs/optText"
        },
        "equivalence": {
          "enum": [
            "exact",
            "approximate",
            "contextual"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
