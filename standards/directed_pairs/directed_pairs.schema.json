{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/directed_pairs/directed_pairs.schema.json",
  "title": "Public multilingual directed pairs translation contract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_id", "source_language", "target_language", "translations"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "document_id": {"$ref": "#/$defs/id"},
    "source_language": {"$ref": "#/$defs/lang"},
    "target_language": {"$ref": "#/$defs/lang"},
    "translations": {
      "type": "array",
      "items": {"$ref": "#/$defs/translation"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$"},
    "text": {"type": "string", "minLength": 1},
    "optText": {"type": ["string", "null"], "minLength": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance_id", "source_version", "confidence"],
      "properties": {
        "provenance_id": {"$ref": "#/$defs/id"},
        "source_version": {"$ref": "#/$defs/text"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1.0},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "publication_approved": {"type": "boolean"},
        "fixture_only": {"type": "boolean"}
      }
    },
    "exampleTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "text"],
      "properties": {
        "language": {"$ref": "#/$defs/lang"},
        "text": {"$ref": "#/$defs/text"}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_id", "text"],
      "properties": {
        "example_id": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/text"},
        "translations": {
          "type": "array",
          "items": {"$ref": "#/$defs/exampleTranslation"}
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_id", "from_sense_id", "to_sense_id", "text", "equivalence", "source"],
      "properties": {
        "translation_id": {"$ref": "#/$defs/id"},
        "from_sense_id": {"$ref": "#/$defs/id"},
        "to_sense_id": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/text"},
        "equivalence": {"enum": ["exact", "literal", "approximate", "contextual"]},
        "context": {"$ref": "#/$defs/optText"},
        "domains": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {"$ref": "#/$defs/example"}
        },
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
