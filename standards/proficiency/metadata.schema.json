{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/proficiency/metadata.schema.json",
  "title": "Open Proficiency Metadata & CEFR Evidence Standard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "classification_target",
    "label_status",
    "cefr_level",
    "coarse_difficulty"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "classification_target": {
      "enum": ["entry", "example"]
    },
    "label_status": {
      "enum": ["unverified", "estimated", "verified"]
    },
    "cefr_level": {
      "enum": ["unknown", "A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "coarse_difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beginner", "intermediate", "advanced"],
      "properties": {
        "beginner": { "type": "boolean" },
        "intermediate": { "type": "boolean" },
        "advanced": { "type": "boolean" }
      }
    },
    "evaluation_method": {
      "enum": ["descriptor_guided_review", "published_content_assignment", "unknown"]
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "enum": ["needs_review", "reviewed", "approved", "rejected"]
    }
  }
}
