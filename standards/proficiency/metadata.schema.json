{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/proficiency/metadata.schema.json",
  "title": "Open Proficiency Metadata Standard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proficiency_level",
    "coarse_difficulty",
    "source_identity",
    "evaluation_method",
    "status",
    "language_applicability",
    "assessment_policy"
  ],
  "properties": {
    "proficiency_level": {
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "unknown"]
    },
    "coarse_difficulty": {
      "enum": ["beginner", "intermediate", "advanced", "unknown"]
    },
    "source_identity": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["verified", "estimated", "unverified"]
    },
    "language_applicability": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "minItems": 1
    },
    "assessment_policy": {
      "type": "string",
      "minLength": 1
    },
    "classification_level": {
      "enum": ["entry-level", "example-level"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "type": "string"
    }
  }
}
