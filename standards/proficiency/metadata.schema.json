{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/proficiency/metadata.schema.json",
  "title": "Open Proficiency Metadata & CEFR Evidence Standard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "classification_type",
    "status",
    "level",
    "coarse_difficulty"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "classification_type": {
      "type": "string",
      "enum": ["entry-level", "example-level"]
    },
    "status": {
      "type": "string",
      "enum": ["verified", "estimated", "unverified"]
    },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "unknown"]
    },
    "coarse_difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "unknown"]
    },
    "source_identity": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_method": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "reviewed", "rejected"]
    }
  },
  "dependentRequired": {
    "source_identity": ["evaluation_method"],
    "evaluation_method": ["source_identity"]
  }
}
