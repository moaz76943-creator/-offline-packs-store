{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/proficiency/record.schema.json",
  "title": "Evidence-aware proficiency content record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "language",
    "classification_status",
    "proficiency_framework_id",
    "proficiency_level_id",
    "skills",
    "complexity",
    "script_literacy",
    "topic_domains",
    "prerequisites",
    "evidence"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "classification_status": {
      "enum": [
        "unknown",
        "unassessed",
        "estimated",
        "source_attested"
      ]
    },
    "proficiency_framework_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proficiency_level_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading",
        "writing",
        "listening",
        "speaking"
      ],
      "properties": {
        "reading": {
          "$ref": "#/$defs/skill"
        },
        "writing": {
          "$ref": "#/$defs/skill"
        },
        "listening": {
          "$ref": "#/$defs/skill"
        },
        "speaking": {
          "$ref": "#/$defs/skill"
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_difficulty",
        "sentence_complexity",
        "grammar_complexity",
        "reading_competence"
      ],
      "properties": {
        "word_difficulty": {
          "$ref": "#/$defs/measure"
        },
        "sentence_complexity": {
          "$ref": "#/$defs/measure"
        },
        "grammar_complexity": {
          "$ref": "#/$defs/measure"
        },
        "reading_competence": {
          "$ref": "#/$defs/measure"
        }
      }
    },
    "script_literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_codes",
        "status"
      ],
      "properties": {
        "script_codes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]{3}$"
          }
        },
        "status": {
          "enum": [
            "unknown",
            "not_required",
            "required",
            "assessed"
          ]
        }
      }
    },
    "topic_domains": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "frequency_evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/frequency"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status"
      ],
      "properties": {
        "mode": {
          "enum": [
            "receptive",
            "productive"
          ]
        },
        "status": {
          "enum": [
            "unknown",
            "not_assessed",
            "developing",
            "demonstrated"
          ]
        }
      }
    },
    "measure": {
      "enum": [
        "unknown",
        "low",
        "moderate",
        "high"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_version",
        "source_url",
        "locator",
        "method",
        "reviewer_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "descriptor_guided_review",
            "published_content_assignment"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_version",
        "source_url",
        "rank",
        "corpus"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "corpus": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
