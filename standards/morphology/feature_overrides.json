  "contracts": {
    "slavic_aspect": {
      "languages": [
        "ru",
        "uk",
        "pl"
      ],
      "features": [
        "aspect"
      ],
      "rule": "Aspect is lexeme-specific; never derive a partner without attested lexeme linkage."
    },
    "turkic_harmony": {
      "languages": [
        "tr",
        "az",
        "kk"
      ],
      "features": [
        "vowel_harmony",
        "agglutinative_sequences"
      ],
      "rule": "Harmony class and ordered suffixes must be recorded per lexeme and dialect."
    },
    "bantu_noun_class": {
      "languages": [
        "sw",
        "zu",
        "xh"
      ],
      "features": [
        "noun_classes",
        "agreement"
      ],
      "rule": "Noun classes are not grammatical genders; agreement targets require attested patterns."
    },
    "cjk_classifiers": {
      "languages": [
        "zh",
        "ja",
        "ko"
      ],
      "features": [
        "classifiers"
      ],
      "rule": "Classifiers/counters require syntactic context; do not infer from part of speech."
    },
    "segmentation": {
      "languages": [
        "zh",
        "ja",
        "ko",
        "th",
        "lo",
        "vi"
      ],
      "features": [
        "segmentation"
      ],
      "rule": "Segmentation is language and orthography specific; spacing is not a universal word-boundary heuristic."
    },
    "tone_and_analytic": {
      "languages": [
        "zh",
        "vi"
      ],
      "features": [
        "tone",
        "analytic"
      ],
      "rule": "Tones attach to lexical readings; analytic grammar is not an absence of syntax."
    },
    "root_pattern": {
      "languages": [
        "ar"
      ],
      "features": [
        "root_pattern",
        "nonconcatenative"
      ],
      "rule": "Store roots and templates as attested lexical properties; never manufacture a broken plural."
    }
  }
