{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/standards/lexical/lexical.schema.json",
  "title": "Public multilingual lexical contract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_id", "lexemes", "senses", "translations", "examples", "relations"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "document_id": {"$ref": "#/$defs/id"},
    "lexemes": {"type": "array", "items": {"$ref": "#/$defs/lexeme"}},
    "senses": {"type": "array", "items": {"$ref": "#/$defs/sense"}},
    "translations": {"type": "array", "items": {"$ref": "#/$defs/translation"}},
    "examples": {"type": "array", "items": {"$ref": "#/$defs/example"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$"},
    "text": {"type": "string", "minLength": 1},
    "optText": {"type": ["string", "null"], "minLength": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "script": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "origin_url", "publisher", "dataset_version", "retrieval_id", "license_id", "record_locator", "publication_approved", "fixture_only"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "origin_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "publisher": {"$ref": "#/$defs/text"},
        "dataset_version": {"$ref": "#/$defs/text"},
        "retrieval_id": {"$ref": "#/$defs/text"},
        "license_id": {"$ref": "#/$defs/text"},
        "record_locator": {"$ref": "#/$defs/text"},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "publication_approved": {"type": "boolean"},
        "fixture_only": {"type": "boolean"}
      }
    },
    "featureMap": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "form": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "features", "attested"],
      "properties": {
        "surface": {"$ref": "#/$defs/text"},
        "features": {"$ref": "#/$defs/featureMap"},
        "attested": {"const": true},
        "source": {"$ref": "#/$defs/source"},
        "variant": {"$ref": "#/$defs/optText"},
        "auxiliary": {"$ref": "#/$defs/optText"}
      }
    },
    "morphology": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gender": {"$ref": "#/$defs/optText"},
        "noun_class": {"$ref": "#/$defs/optText"},
        "number": {"$ref": "#/$defs/optText"},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
        "articles": {"type": "array", "items": {"$ref": "#/$defs/form"}},
        "classifiers": {"type": "array", "items": {"$ref": "#/$defs/form"}},
        "inflections": {"type": "array", "items": {"$ref": "#/$defs/form"}},
        "conjugations": {"type": "array", "items": {"$ref": "#/$defs/form"}},
        "irregular_forms": {"type": "array", "items": {"$ref": "#/$defs/form"}},
        "roots": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "patterns": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "prefix_chain": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "suffix_chain": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "components": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "pronunciation": {
      "type": "object", "additionalProperties": false,
      "required": ["notation", "value"],
      "properties": {
        "notation": {"enum": ["ipa", "phonetic", "romanization", "other"]},
        "value": {"$ref": "#/$defs/text"},
        "stress": {"$ref": "#/$defs/optText"},
        "dialect": {"$ref": "#/$defs/optText"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "lexeme": {
      "type": "object", "additionalProperties": false,
      "required": ["lexeme_id", "language", "script", "lemma", "surface", "pos", "source"],
      "properties": {
        "lexeme_id": {"$ref": "#/$defs/id"},
        "language": {"$ref": "#/$defs/lang"},
        "script": {"$ref": "#/$defs/script"},
        "dialect": {"$ref": "#/$defs/optText"},
        "direction": {"enum": ["ltr", "rtl", "ttb"]},
        "lemma": {"$ref": "#/$defs/text"},
        "surface": {"$ref": "#/$defs/text"},
        "pos": {"enum": ["noun", "verb", "adjective", "adverb", "pronoun", "particle", "preposition", "conjunction", "interjection", "determiner", "numeral", "classifier", "multiword", "other"]},
        "homograph_key": {"$ref": "#/$defs/optText"},
        "register": {"$ref": "#/$defs/optText"},
        "morphology": {"$ref": "#/$defs/morphology"},
        "pronunciations": {"type": "array", "items": {"$ref": "#/$defs/pronunciation"}},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "level": {
      "type": "object", "additionalProperties": false,
      "required": ["framework_id", "level_id"],
      "properties": {"framework_id": {"$ref": "#/$defs/id"}, "level_id": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/optText"}}
    },
    "sense": {
      "type": "object", "additionalProperties": false,
      "required": ["sense_id", "lexeme_id", "concept_id", "definition", "source"],
      "properties": {
        "sense_id": {"$ref": "#/$defs/id"},
        "lexeme_id": {"$ref": "#/$defs/id"},
        "concept_id": {"$ref": "#/$defs/id"},
        "definition": {"$ref": "#/$defs/text"},
        "usage_context": {"$ref": "#/$defs/optText"},
        "domains": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "subdomains": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "semantic_tags": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "register": {"$ref": "#/$defs/optText"},
        "frequency": {"type": ["number", "null"], "minimum": 0},
        "difficulty": {"type": ["number", "null"], "minimum": 0},
        "levels": {"type": "array", "items": {"$ref": "#/$defs/level"}},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "translation": {
      "type": "object", "additionalProperties": false,
      "required": ["translation_id", "from_sense_id", "to_sense_id", "language", "text", "equivalence", "source"],
      "properties": {
        "translation_id": {"$ref": "#/$defs/id"},
        "from_sense_id": {"$ref": "#/$defs/id"},
        "to_sense_id": {"$ref": "#/$defs/id"},
        "language": {"$ref": "#/$defs/lang"},
        "text": {"$ref": "#/$defs/text"},
        "equivalence": {"enum": ["exact", "approximate", "contextual"]},
        "context": {"$ref": "#/$defs/optText"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "exampleTranslation": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "text", "source"],
      "properties": {"language": {"$ref": "#/$defs/lang"}, "text": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/source"}}
    },
    "example": {
      "type": "object", "additionalProperties": false,
      "required": ["example_id", "sense_id", "language", "script", "text", "source"],
      "properties": {
        "example_id": {"$ref": "#/$defs/id"},
        "sense_id": {"$ref": "#/$defs/id"},
        "language": {"$ref": "#/$defs/lang"},
        "script": {"$ref": "#/$defs/script"},
        "text": {"$ref": "#/$defs/text"},
        "translations": {"type": "array", "items": {"$ref": "#/$defs/exampleTranslation"}},
        "grammar_annotations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["span", "feature"], "properties": {"span": {"$ref": "#/$defs/text"}, "feature": {"$ref": "#/$defs/text"}, "explanation_ref": {"$ref": "#/$defs/optText"}}}},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "from_lexeme_id", "to_lexeme_id", "kind", "source"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/id"},
        "from_lexeme_id": {"$ref": "#/$defs/id"},
        "to_lexeme_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["derivation", "compound", "root", "prefix", "suffix", "variant", "related"]},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
