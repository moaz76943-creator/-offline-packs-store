+# Existing verification task types are bounded to ten minutes, independently
+# of the 295-minute Actions watchdog. No Issue supplies a command or timeout.
+WORK_TIMEOUT_SECONDS = 600
+
+
+def _execute_work(sender,t,directory,root):
+    if os.name=='posix':
+        os.setsid()  # Include fixed subprocess descendants in timeout cleanup.
+    try:
+        try:
+            result=work(t,directory,root)
+        except (OSError,ValueError,TypeError,KeyError,subprocess.TimeoutExpired):
+            result=('FAILED',t['checkpoint'],0,None,'EXECUTION')
+        try:
+            sender.send(result)
+        except (BrokenPipeError,EOFError):
+            pass  # Parent timed out; never retry a send into a closed channel.
+    finally:
+        sender.close()
+
+
+def _stop_process(process,force=False):
+    if os.name=='posix':
+        try:
+            os.killpg(process.pid,signal.SIGKILL if force else signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+    if process.is_alive():
+        if force:process.kill()
+        else:process.terminate()
+
+
+def bounded_work(t,directory,root,timeout=WORK_TIMEOUT_SECONDS):
+    if not 0<timeout<=WORK_TIMEOUT_SECONDS:
+        raise ValueError('invalid execution bound')
+    ctx=multiprocessing.get_context('spawn')
+    receiver,sender=ctx.Pipe(duplex=False)
+    process=ctx.Process(target=_execute_work,args=(sender,t,directory,root))
+    try:
+        process.start()
+        sender.close()
+        if not receiver.poll(timeout):
+            return ('FAILED',t['checkpoint'],0,None,'TIMEOUT')
+        try:
+            return receiver.recv()
+        except EOFError:
+            return ('FAILED',t['checkpoint'],0,None,'EXECUTION')
+    finally:
+        sender.close()
+        receiver.close()
+        if process.pid is not None:
+            process.join(timeout=1)
+            if process.is_alive():
+                _stop_process(process)
+                process.join(timeout=2)
+            if process.is_alive():
+                _stop_process(process,force=True)
+                process.join(timeout=2)
+            process.close()
+
