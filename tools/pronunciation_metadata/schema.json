{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/tools/pronunciation_metadata/schema.json",
  "title": "Public pronunciation metadata registry schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "language",
    "lexical_entry_id",
    "provenance_id",
    "source_version",
    "offline_voice_availability"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{2,128}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "dialect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lexical_entry_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "sense_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "ipa": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phonetic_transliteration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phonetic_notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "offline_voice_availability": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ],
      "default": "unknown"
    },
    "provenance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    }
  }
}
