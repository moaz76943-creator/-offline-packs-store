{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moaz76943-creator/-offline-packs-store/blob/main/tools/factory_extensions/grammar_evidence/rule.schema.json",
  "title": "Language-owned source-backed grammar candidate 1.0.0",
  "description": "Validation of identifiers and types only. Semantic links, legal evidence and human approval are enforced separately by factory.py and upstream Route05 gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "language",
    "kind",
    "capability",
    "domain",
    "pattern",
    "explanation",
    "register",
    "exceptions",
    "prerequisites",
    "sources",
    "lexeme_refs",
    "form_refs",
    "example_refs",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^gr1:[a-z]{2,3}:[a-z][a-z0-9_]{2,63}:v[1-9][0-9]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "kind": {
      "enum": [
        "descriptive",
        "pedagogical"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "feature_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "register": {
      "enum": [
        "formal",
        "neutral",
        "informal",
        "colloquial",
        "literary",
        "unknown"
      ]
    },
    "exceptions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "description",
          "source_locator"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "source_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^gr1:[a-z]{2,3}:[a-z][a-z0-9_]{2,63}:v[1-9][0-9]*$"
      }
    },
    "descriptive_rule_id": {
      "type": "string",
      "pattern": "^gr1:[a-z]{2,3}:[a-z][a-z0-9_]{2,63}:v[1-9][0-9]*$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "dataset_version",
          "artifact_sha256",
          "record_locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "dataset_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "record_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "lexeme_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lexeme_id",
          "sense_id"
        ],
        "properties": {
          "lexeme_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "sense_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "form_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lemma_id",
          "sense_id",
          "form",
          "features",
          "dataset_version",
          "artifact_sha256",
          "record_locator",
          "evidence_version"
        ],
        "properties": {
          "lemma_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "sense_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "form": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "dataset_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "record_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "example_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "example_id",
          "annotation"
        ],
        "properties": {
          "example_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "annotation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "span",
              "feature"
            ],
            "properties": {
              "span": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "feature": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewer_id",
        "decision_url",
        "rule_sha256"
      ],
      "properties": {
        "decision": {
          "const": "approved"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "decision_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "rule_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
