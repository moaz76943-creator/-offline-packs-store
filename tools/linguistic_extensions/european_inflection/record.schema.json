{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "European inflection: exactly source-bound, non-generative records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "language_code",
    "lemma_id",
    "sense_id",
    "lemma",
    "form",
    "script",
    "category",
    "features",
    "paradigm_complete",
    "evidence_status",
    "source_refs"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 3
    },
    "language_code": {
      "enum": [
        "ru",
        "uk",
        "pl",
        "cs",
        "sk",
        "bg",
        "sr",
        "hr",
        "bs",
        "sl",
        "mk",
        "be",
        "el",
        "lt",
        "lv",
        "ga",
        "cy",
        "gd",
        "br"
      ]
    },
    "lemma_id": {
      "type": "string",
      "minLength": 3
    },
    "sense_id": {
      "type": "string",
      "minLength": 3
    },
    "lemma": {
      "type": "string",
      "minLength": 1
    },
    "form": {
      "type": "string"
    },
    "script": {
      "enum": [
        "Latn",
        "Cyrl",
        "Grek"
      ]
    },
    "category": {
      "enum": [
        "noun",
        "verb",
        "adjective",
        "construction"
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "paradigm_complete": {
      "const": false
    },
    "evidence_status": {
      "enum": [
        "verified",
        "predicted",
        "gap",
        "disagreement"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "dataset_version",
          "artifact_sha256",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "dataset_version": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gap_note": {
      "type": "string",
      "minLength": 1
    },
    "prediction_note": {
      "type": "string",
      "minLength": 1
    },
    "disagreement_note": {
      "type": "string",
      "minLength": 1
    },
    "orthographic_variant_of": {
      "type": "string",
      "minLength": 3
    }
  }
}
